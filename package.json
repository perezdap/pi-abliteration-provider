{
  "name": "pi-abliteration-provider",
  "version": "0.1.0",
  "description": "Abliteration AI provider for pi with API-key login, reasoning, vision, tool calling, and cache-aware pricing.",
  "type": "module",
  "main": "index.ts",
  "files": ["index.ts", "README.md", "LICENSE"],
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "engines": { "node": ">=22" },
  "pi": { "extensions": ["./index.ts"] },
  "keywords": ["pi-package", "pi-extension", "abliteration", "provider", "llm"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/perezdap/pi-abliteration-provider.git" },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
